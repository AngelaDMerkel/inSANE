<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AssemblyName>inSANE</AssemblyName>
    <RootNamespace>InSane</RootNamespace>
    <PackageLicenseExpression>GPL-2.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/AngelaDMerkel/inSANE</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AngelaDMerkel/inSANE</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright 2026 inSANE Contributors</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAPS2.Sdk" />
    <PackageReference Include="NAPS2.Images.ImageSharp" />
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>
</Project>
