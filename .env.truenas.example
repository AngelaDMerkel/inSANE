# Copy this file to .env beside compose.paperless-truenas.yaml on TrueNAS.
# Never commit the completed .env file.

INSANE_IMAGE=DOCKERHUB_USERNAME/insane:1.0.0-amd64
PAPERLESS_DB_PASSWORD=replace-with-a-long-random-password
PAPERLESS_SECRET_KEY=replace-with-a-long-random-secret-key

# TrueNAS SCALE's standard apps identity.
PAPERLESS_UID=568
PAPERLESS_GID=568
