<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep the NAPS2 packages together so upstream upgrades are deliberate and reviewable. -->
    <PackageVersion Include="NAPS2.Sdk" Version="1.3.0" />
    <PackageVersion Include="NAPS2.Images.ImageSharp" Version="1.3.0" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.11" />
  </ItemGroup>
</Project>
